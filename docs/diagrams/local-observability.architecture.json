        "id": "prepared-upload",
        "label": "Prepared upload boundary",
        "focus": [
          "traces",
          "exporter",
          "arize"
        ],
        "note": "Uploads are off. Later use needs a selected payload, two opt-ins, the intended space/region/project and account acceptance."
      }
    ]
