        "label": "Trace binding and privacy",
        "focus": [
          "engine",
          "observer",
          "traces",
          "scores"
        ],
        "note": "Revision, amount and outcome bind investigations to checks. Text, internal identities, secrets and exception messages are excluded."
      },
