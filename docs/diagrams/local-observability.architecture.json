  "cards": [
    {
      "dot": "emerald",
      "title": "Current and original reports",
      "items": [
        "Current PostgreSQL and original SQLite reports retain separate source versions and actual results.",
        "Each score binds to a recorded investigation. Lost capture or changed source files prevent an overall pass."
      ]
    },
    {
      "dot": "amber",
      "title": "Model and tracing boundaries",
      "items": [
        "Hosted model selection is prepared. Local launchers use rules; SQL checks and human approval remain independent.",
        "Hosted tracing is opt-in memory: 128 spans or 256 KiB. No durable collection or upload is configured."
      ]
    },
    {
      "dot": "rose",
      "title": "Explain and validate",
      "items": [
        "Judge mode replays saved events and separates later case context. Playback cannot investigate, approve or pay.",
        "The business kit prepares interviews and timed review. No customer results or savings have been measured."
      ]
    }
