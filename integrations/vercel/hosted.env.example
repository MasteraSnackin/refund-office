# Preparation only. This file is not automatically loaded or uploaded.
REFUND_OFFICE_NETWORK=offline
REFUND_OFFICE_HOSTED=disabled
REFUND_OFFICE_WORKING_STORE=sqlite
REFUND_OFFICE_ENABLED_INTEGRATIONS=
REFUND_OFFICE_PUBLIC_ORIGIN=
REFUND_OFFICE_HOSTED_TENANT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate 32 random bytes as base64url outside source control; never use a sample.
REFUND_OFFICE_SESSION_SECRET=
# Separate machine credential and actual investigator account UUID.
REFUND_OFFICE_MACHINE_KEY=
REFUND_OFFICE_MACHINE_USER_ID=
# Optional sponsor actions still need individual allowlist entries and keys.
# See integrations/.env.example and docs/HOSTED-SETUP.md.
REFUND_OFFICE_ANALYSER=local
REFUND_OFFICE_CHALLENGER=none

# Separate optional Stripe TEST execution. Ordinary case approvals stay unpaid.
REFUND_OFFICE_PAYMENT_EXECUTION=disabled
REFUND_OFFICE_PAYMENT_MACHINE_KEY=
REFUND_OFFICE_PAYMENT_MACHINE_USER_ID=
STRIPE_SECRET_KEY=
