# Preparation only. The application does not automatically read or activate these.
# A separate export operation must explicitly map both opt-ins and confirm one
# bounded synthetic trace selection. A key alone cannot enable any request.
ARIZE_NETWORK_ENABLED=false
ARIZE_TRACE_UPLOAD_ENABLED=false
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=refund-office-synthetic
# Explicitly choose us or eu to match the future account's space.
ARIZE_REGION=

# Normal application traces stay local. The launcher controls whether it creates
# a recorder and which run-specific local path it uses; these are not SDK flags.
# No automatic model instrumentation, customer text, prompts or responses.
