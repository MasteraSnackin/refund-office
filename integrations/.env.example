# This file is a template. The application does not load it automatically.
# Keep secrets server-side. Never commit a filled copy or use VITE_ secret names.
REFUND_OFFICE_NETWORK=offline
REFUND_OFFICE_ENABLED_INTEGRATIONS=
REFUND_OFFICE_ANALYSER=local
# Optional advisory comparison only; leave disabled for local rehearsal.
REFUND_OFFICE_CHALLENGER=none

# OpenAI: optional proposal adapter, not refund approval.
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic: optional alternative proposal adapter, not a second approver.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional bounded read-only tool investigator. Leave absent for the original
# single-proposal adapter; selecting tools still requires every provider opt-in.
REFUND_OFFICE_ANTHROPIC_MODE=

# ElevenLabs: an explicitly chosen voice is required; no fallback voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Stripe: test credentials only. The current local simulator needs no key.
STRIPE_SECRET_KEY=

# n8n: inactive workflow, authenticated webhook, no payment or approval nodes.
N8N_INTAKE_WEBHOOK_URL=
N8N_INTAKE_TOKEN=

# Supabase: archive and separate operational store; see docs/HOSTED-SETUP.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Reviewer access tokens are passed per request, not saved in this template.

# Miro: existing board and token; no board is created by local export.
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=

# Modal: optional authenticated text extraction endpoint.
MODAL_EVIDENCE_URL=
MODAL_EVIDENCE_TOKEN=

# Port: metadata-only catalog entry and pre-created blueprint.
PORT_API_URL=
PORT_ACCESS_TOKEN=
PORT_BLUEPRINT_ID=refund-office-service

# Vercel: reserved deployment identifiers only; no deploy command is included.
# The old static template returns 503; hosted.vercel.json selects the prepared API.
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
