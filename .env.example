# Safe local defaults. This template is not loaded automatically.
# See docs/integrations.md and integrations/SETUP.md.
# Full sponsor placeholders: integrations/.env.example.
# Keep filled files private and out of source control. Never use VITE_ secret names.
REFUND_OFFICE_NETWORK=offline
REFUND_OFFICE_ANALYSER=local
# Optional advisory comparison only; leave disabled for local rehearsal.
REFUND_OFFICE_CHALLENGER=none
REFUND_OFFICE_ENABLED_INTEGRATIONS=

# Optional local paths. A new DB_PATH creates a separate practice database.
DB_PATH=.data/refund-office.sqlite
API_PORT=4174

# Model proposals remain advisory. No account or model has been verified.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Saved-briefing voice action. No default voice; disconnected until enabled.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Test payments only. The local simulator needs neither value.
STRIPE_SECRET_KEY=
STRIPE_API_KEY=

# Prepared clients also require their name in the integration allowlist.
N8N_INTAKE_WEBHOOK_URL=
N8N_INTAKE_TOKEN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MIRO_ACCESS_TOKEN=
MIRO_BOARD_ID=
MODAL_EVIDENCE_URL=
MODAL_EVIDENCE_TOKEN=
PORT_API_URL=
PORT_BLUEPRINT_ID=
PORT_ACCESS_TOKEN=

# Separate hosted API source is prepared; nothing is deployed.
# No deployment credentials are required or read by the local application.
